def set_training_mode(model):

    model.train()

    # Keep frozen decoder layers in evaluation mode
    for layer in decoder_layers[:freeze_until]:
        layer.eval()

    # Keep frozen embeddings in evaluation mode
    if FREEZE_EMBEDDINGS:
        for module in embedding_modules:
            module.eval()

    if embedding_dropout is not None:
        embedding_dropout.eval()

# =========================================================
# 15. TRAINING FUNCTION
# =========================================================

def train_one_epoch(
    model,
    loader,
    optimizer,
    scheduler,
    scaler,
    epoch
):

    set_training_mode(model)

    total_loss = 0.0

    iterator = iter(loader)

    for step in range(steps_per_epoch):

        input_ids = next(iterator)

        input_ids = input_ids.to(
            device,
            non_blocking=True
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        with torch.cuda.amp.autocast(
            enabled=USE_AMP
        ):

            outputs = model(
                input_ids=input_ids,

                # GPT-2 internally shifts labels
                # for causal next-token prediction.

                labels=input_ids
            )

            loss = outputs.loss

        scaler.scale(loss).backward()

        scaler.unscale_(optimizer)

        # Clip only trainable parameters.

        torch.nn.utils.clip_grad_norm_(
            trainable_params,
            MAX_GRAD_NORM
        )

        scaler.step(optimizer)

        scaler.update()

        scheduler.step()

        total_loss += loss.item()

        current_lr = scheduler.get_last_lr()[0]

        if (step + 1) % 100 == 0:

            print(
                f"Epoch {epoch + 1} | "
                f"Step {step + 1}/{steps_per_epoch} | "
                f"Loss: {loss.item():.4f} | "
                f"LR: {current_lr:.8f}"
            )

    average_loss = (
        total_loss / steps_per_epoch
    )

    return average_loss


