@torch.no_grad()
def evaluate_model(
    model,
    loader
):

    model.eval()

    total_loss = 0.0

    total_correct = 0

    total_tokens = 0

    processed_samples = 0

    for step, input_ids in enumerate(loader):

        if step >= validation_steps:

            break

        input_ids = input_ids.to(
            device,
            non_blocking=True
        )

        with torch.cuda.amp.autocast(
            enabled=USE_AMP
        ):

            outputs = model(
                input_ids=input_ids,
                labels=input_ids
            )

            loss = outputs.loss

        batch_size = input_ids.size(0)

        total_loss += (
            loss.item() * batch_size
        )

        processed_samples += batch_size

        # Next-token prediction.

        predictions = outputs.logits[:, :-1, :].argmax(
            dim=-1
        )

        targets = input_ids[:, 1:]

        total_correct += (
            predictions == targets
        ).sum().item()

        total_tokens += targets.numel()

    average_loss = (
        total_loss / processed_samples
        if processed_samples > 0
        else 0.0
    )

    accuracy = (
        total_correct / total_tokens
        if total_tokens > 0
        else 0.0
    )

    perplexity = math.exp(
        min(average_loss, 20)
    )

    return {
        "loss": average_loss,
        "accuracy": accuracy,
        "perplexity": perplexity
    }


