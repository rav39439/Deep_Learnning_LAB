def get_directory_size(path):

    total_size = 0

    for root, dirs, files in os.walk(path):

        for file in files:

            file_path = os.path.join(
                root,
                file
            )

            total_size += os.path.getsize(
                file_path
            )

    return total_size / (1024 ** 2)


