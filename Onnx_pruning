# MODEL CONFIGURATION — MATCHES THE CHECKPOINT
# =========================================================

NUM_LAYERS = 18
NUM_HEADS = 8

D_MODEL = 512
DFF = 512

VOCAB_SIZE = 30527

MAX_POSITION_ENCODING = 512
INPUT_SEQ_LEN = 512

DROPOUT = 0.1

WEIGHTS_PATH = (
    "/kaggle/input/datasets/ravckumar/"
    "questionandanswerfinetune-512-14-1/"
    "final_transformer64.weights.h5"
)

ONNX_PATH = "/kaggle/working/transformer_pruned_fp16.onnx"

# =========================================================
# BUILD MODEL
# =========================================================

model = DecoderOnlyTransformer(
    num_layers=NUM_LAYERS,
    d_model=D_MODEL,
    num_heads=NUM_HEADS,
    dff=DFF,
    vocab_size=VOCAB_SIZE,
    maximum_position_encoding=MAX_POSITION_ENCODING,
    rate=DROPOUT
)

# Build all model variables before loading weights
dummy_input = tf.zeros(
    (1, INPUT_SEQ_LEN),
    dtype=tf.int32
)

_ = model(dummy_input, training=False)

print("Model built successfully.")
print("Decoder blocks:", len(model.dec_layers))
