#---------------second round of pruning---------------

import onnx
from onnxconverter_common import float16

PRUNED_ONNX_PATH = "/kaggle/working/transformer_pruned.onnx"
FP16_ONNX_PATH = "/kaggle/working/transformer2_pruned_fp16.onnx"

# Always start from the original pruned FP32 model
pruned_model = onnx.load(PRUNED_ONNX_PATH)

# Operations that should remain in FP32
op_block_list = [
    "Less",
    "LessOrEqual",
    "Greater",
    "GreaterOrEqual",
    "Equal",
    "Where",
    "Cast",
    "Shape",
    "Gather",
    "Range",
    "Mul",
    "Add",
    "Sub",
    "Div",
    "Pow",
    "Sqrt"
]

fp16_model = float16.convert_float_to_float16(
    pruned_model,
    keep_io_types=True,
    op_block_list=op_block_list,
    max_finite_val=65504.0,
    disable_shape_infer=False
)

# Validate graph
onnx.checker.check_model(fp16_model)

# Save
onnx.save(fp16_model, FP16_ONNX_PATH)

print("Mixed precision conversion completed!")


