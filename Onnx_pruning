print("All checkpoint dimensions verified.")
print("Total parameters:", model.count_params())

import tf2onnx
import onnx
import numpy as np
import tensorflow as tf

# =========================================================
# EXPORT TO ONNX
# =========================================================

@tf.function(
    input_signature=[
        tf.TensorSpec(
            shape=[None, INPUT_SEQ_LEN],
            dtype=tf.int32,
            name="input_ids"
        )
    ]
)
def serving_function(input_ids):
    logits = model(input_ids, training=False)
    return {"logits": logits}


onnx_model, _ = tf2onnx.convert.from_function(
    serving_function,
    input_signature=serving_function.input_signature,
    opset=17
)

onnx.checker.check_model(onnx_model)

onnx.save(
    onnx_model,
    "/kaggle/working/transformer_original.onnx"
)

print("ONNX conversion completed.")

# =========================================================
# ONNX WEIGHT PRUNING
# =========================================================

from onnx import numpy_helper

PRUNING_RATIO = 0.20

onnx_model = onnx.load(
    "/kaggle/working/transformer_original.onnx"
)

pruned_count = 0
total_pruned = 0
total_weights = 0

for initializer in onnx_model.graph.initializer:

    # weights = numpy_helper.to_array(initializer)
    weights = numpy_helper.to_array(initializer).copy()

    # Prune only 512 x 512 weight matrices
    if weights.ndim == 2 and weights.shape == (512, 512):

        abs_weights = np.abs(weights)

        threshold = np.quantile(
            abs_weights,
            PRUNING_RATIO
        )

        mask = abs_weights <= threshold

        total_pruned += np.count_nonzero(mask)
        total_weights += weights.size

        weights[mask] = 0

        initializer.CopyFrom(
            numpy_helper.from_array(
                weights,
                name=initializer.name
            )
        )

        pruned_count += 1


onnx.checker.check_model(onnx_model)

onnx.save(
    onnx_model,
    "/kaggle/working/transformer_pruned.onnx"
)

print("Pruning completed.")
print("Matrices pruned:", pruned_count)
print("Weights pruned:", total_pruned)
print("Total eligible weights:", total_weights)

if total_weights:
    print(
        "Actual sparsity:",
        round(100 * total_pruned / total_weights, 2),
        "%"
    )


