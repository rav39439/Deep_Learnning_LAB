# ============================================================
# PIXART-ALPHA FINE-TUNING ON FLICKR30K
# Optimized for a 14.56 GB CUDA GPU
#
# Stage 1: T5 GPU -> cache text embeddings -> release T5
# Stage 2: VAE GPU -> cache image latents -> release VAE
# Stage 3: PixArt GPU -> fine-tune transformer
#
# Dataset:
# 30 unique images
# 20 training images
# 5 validation images
# 5 unused images
#
# Trainable:
# Last 2 transformer blocks + output projection
# ============================================================


# ============================================================
# 1. IMPORTS
# ============================================================

import os
import gc
import json
import random
import numpy as np
import pandas as pd

from PIL import Image
from tqdm.auto import tqdm

import torch
import torch.nn.functional as F

from torch.utils.data import Dataset, DataLoader
from torchvision import transforms

from transformers import (
    T5Tokenizer,
    T5EncoderModel
)

from diffusers import (
    PixArtTransformer2DModel,
    AutoencoderKL,
    DDPMScheduler
)


# ============================================================
# 2. CONFIGURATION
# ============================================================

MODEL_NAME = "PixArt-alpha/PixArt-XL-2-512x512"

DATASET_ROOT = (
    "/kaggle/input/datasets/hsankesara/"
    "flickr-image-dataset/flickr30k_images"
)

IMAGE_ROOT = os.path.join(
    DATASET_ROOT,
    "flickr30k_images"
)

CAPTION_FILE = os.path.join(
    DATASET_ROOT,
    "results.csv"
)

OUTPUT_DIR = "/kaggle/working/pixart_finetuned"

TRANSFORMER_OUTPUT_DIR = os.path.join(
    OUTPUT_DIR,
    "transformer"
)

DEVICE = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

IMAGE_SIZE = 512
MAX_TEXT_LENGTH = 120

MAX_IMAGES = 30
TRAIN_IMAGES = 20
VALIDATION_IMAGES = 5

BATCH_SIZE = 1
EPOCHS = 5

LEARNING_RATE = 1e-5
WEIGHT_DECAY = 0.01

GRADIENT_ACCUMULATION_STEPS = 4

CAPTION_DROPOUT = 0.10

NUM_TRAINABLE_BLOCKS = 2

NUM_WORKERS = 0

SEED = 42

USE_FP16 = DEVICE.type == "cuda"

os.makedirs(OUTPUT_DIR, exist_ok=True)
os.makedirs(TRANSFORMER_OUTPUT_DIR, exist_ok=True)

random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

if torch.cuda.is_available():
    torch.cuda.manual_seed_all(SEED)

torch.backends.cuda.matmul.allow_tf32 = True
torch.backends.cudnn.allow_tf32 = True

print("Device:", DEVICE)
print("Dataset root:", DATASET_ROOT)
print("Image directory:", IMAGE_ROOT)
print("Caption file:", CAPTION_FILE)


# ============================================================
# 3. GPU MEMORY UTILITIES
# ============================================================

def clear_memory():

    gc.collect()

    if torch.cuda.is_available():

        torch.cuda.empty_cache()
        torch.cuda.ipc_collect()


def print_gpu_memory(title):

    if not torch.cuda.is_available():
        return

    torch.cuda.synchronize()

    allocated = (
        torch.cuda.memory_allocated() / 1024**3
    )

    reserved = (
        torch.cuda.memory_reserved() / 1024**3
    )

    free, total = torch.cuda.mem_get_info()

    free = free / 1024**3
    total = total / 1024**3

    print(f"\n{title}")
    print(f"GPU total:     {total:.2f} GB")
    print(f"GPU free:      {free:.2f} GB")
    print(f"GPU allocated: {allocated:.2f} GB")
    print(f"GPU reserved:  {reserved:.2f} GB\n")


# ============================================================
# 4. LOAD AND FILTER FLICKR30K DATASET
# ============================================================

class FlickrImageDataset:

    def __init__(
        self,
        image_root,
        caption_file,
        max_images=30
    ):

        self.image_root = image_root

        if not os.path.exists(caption_file):
            raise FileNotFoundError(
                f"Caption file not found: {caption_file}"
            )

        if not os.path.isdir(image_root):
            raise FileNotFoundError(
                f"Image directory not found: {image_root}"
            )

        df = pd.read_csv(
            caption_file,
            sep="|",
            skipinitialspace=True
        )

        df.columns = [
            str(column).strip()
            for column in df.columns
        ]

        required_columns = {
            "image_name",
            "comment"
        }

        if not required_columns.issubset(df.columns):
            raise ValueError(
                f"Expected columns: {required_columns}. "
                f"Found: {list(df.columns)}"
            )

        df = df[
            ["image_name", "comment"]
        ].copy()

        df["image_name"] = (
            df["image_name"]
            .astype(str)
            .str.strip()
        )

        df["comment"] = (
            df["comment"]
            .fillna("")
            .astype(str)
            .str.strip()
        )

        df = df[
            (df["image_name"] != "") &
            (df["comment"] != "")
        ]

        # Select only the first 30 unique image names.
        # Avoid checking every image in the full CSV.

        unique_names = (
            df["image_name"]
            .drop_duplicates()
            .tolist()
        )

        selected_names = unique_names[:max_images]

        valid_names = []

        for image_name in selected_names:

            image_path = os.path.join(
                image_root,
                image_name
            )

            if os.path.isfile(image_path):
                valid_names.append(image_name)

        if not valid_names:
            raise RuntimeError(
                "No valid images found. Check IMAGE_ROOT."
            )

        self.df = df[
            df["image_name"].isin(valid_names)
        ].reset_index(drop=True)

        self.image_names = valid_names

        print("\nDataset loaded successfully")
        print("Unique images:", len(self.image_names))
        print("Caption rows:", len(self.df))


full_dataset = FlickrImageDataset(
    image_root=IMAGE_ROOT,
    caption_file=CAPTION_FILE,
    max_images=MAX_IMAGES
)


# ============================================================
# 5. TRAIN / VALIDATION SPLIT
# ============================================================

unique_images = full_dataset.image_names.copy()

random.shuffle(unique_images)

train_images = unique_images[:TRAIN_IMAGES]

validation_images = unique_images[
    TRAIN_IMAGES:
    TRAIN_IMAGES + VALIDATION_IMAGES
]

unused_images = unique_images[
    TRAIN_IMAGES + VALIDATION_IMAGES:
]

train_df = full_dataset.df[
    full_dataset.df["image_name"].isin(train_images)
].reset_index(drop=True)

validation_df = full_dataset.df[
    full_dataset.df["image_name"].isin(validation_images)
].reset_index(drop=True)

print("\nDataset split")
print("Training images:", len(train_images))
print("Validation images:", len(validation_images))
print("Unused images:", len(unused_images))

print("Training captions:", len(train_df))
print("Validation captions:", len(validation_df))

if not len(train_df) or not len(validation_df):
    raise RuntimeError(
        "Training or validation dataset is empty."
    )


# ============================================================
# 6. IMAGE TRANSFORM
# ============================================================

image_transform = transforms.Compose([

    transforms.Resize(
        IMAGE_SIZE,
        interpolation=transforms.InterpolationMode.BILINEAR
    ),

    transforms.CenterCrop(IMAGE_SIZE),

    transforms.ToTensor(),

    transforms.Normalize(
        [0.5, 0.5, 0.5],
        [0.5, 0.5, 0.5]
    )

])


def load_image(image_name):

    image_path = os.path.join(
        IMAGE_ROOT,
        image_name
    )

    with Image.open(image_path) as image:

        image = image.convert("RGB")

        return image_transform(image)


# ============================================================
# 7. COLLECT UNIQUE CAPTIONS
# ============================================================

all_captions = (
    pd.concat([
        train_df["comment"],
        validation_df["comment"]
    ])
    .drop_duplicates()
    .tolist()
)

# Include empty prompt for classifier-free caption dropout.

all_captions.append("")

all_captions = list(
    dict.fromkeys(all_captions)
)

print("\nUnique captions:", len(all_captions))


# ============================================================
# 8. STAGE 1: LOAD T5 ON GPU
# ============================================================

print("\nLoading T5 text encoder...")

clear_memory()
print_gpu_memory("Before loading T5")

tokenizer = T5Tokenizer.from_pretrained(
    MODEL_NAME,
    subfolder="tokenizer"
)

text_encoder = T5EncoderModel.from_pretrained(
    MODEL_NAME,
    subfolder="text_encoder",
    torch_dtype=(
        torch.float16 if USE_FP16 else torch.float32
    )
)

text_encoder.to(DEVICE)
text_encoder.eval()

text_encoder.requires_grad_(False)

print("T5 loaded on:", DEVICE)

print_gpu_memory("After loading T5")


# ============================================================
# 9. PRECOMPUTE TEXT EMBEDDINGS
# ============================================================

text_embedding_cache = {}

print("\nGenerating caption embeddings...")

with torch.inference_mode():

    for caption in tqdm(all_captions):

        tokens = tokenizer(
            caption,
            max_length=MAX_TEXT_LENGTH,
            padding="max_length",
            truncation=True,
            return_tensors="pt"
        )

        input_ids = tokens.input_ids.to(DEVICE)

        attention_mask = (
            tokens.attention_mask.to(DEVICE)
        )

        with torch.autocast(
            device_type="cuda",
            dtype=torch.float16,
            enabled=USE_FP16
        ):

            outputs = text_encoder(
                input_ids=input_ids,
                attention_mask=attention_mask
            )

        embedding = outputs.last_hidden_state

        text_embedding_cache[caption] = (
            embedding[0]
            .detach()
            .cpu()
            .to(torch.float16)
        )

        text_mask = (
            attention_mask[0]
            .detach()
            .cpu()
            .to(torch.long)
        )

        # Save mask with the caption embedding.
        text_embedding_cache[caption] = (
            text_embedding_cache[caption],
            text_mask
        )


print("Text embeddings cached:", len(text_embedding_cache))


# ============================================================
# 10. RELEASE T5 GPU MEMORY
# ============================================================

del text_encoder
del tokenizer

clear_memory()

print_gpu_memory(
    "After releasing T5"
)


# ============================================================
# 11. STAGE 2: LOAD VAE ON GPU
# ============================================================

print("\nLoading VAE...")

vae = AutoencoderKL.from_pretrained(
    MODEL_NAME,
    subfolder="vae",
    torch_dtype=(
        torch.float16 if USE_FP16 else torch.float32
    )
)

vae.to(DEVICE)
vae.eval()

vae.requires_grad_(False)

print("VAE loaded on:", DEVICE)

print_gpu_memory("After loading VAE")


# ============================================================
# 12. PRECOMPUTE IMAGE LATENTS
# ============================================================

latent_cache = {}

all_selected_images = (
    train_images + validation_images
)

print("\nGenerating image latents...")

with torch.inference_mode():

    for image_name in tqdm(all_selected_images):

        image_tensor = load_image(
            image_name
        ).unsqueeze(0).to(DEVICE)

        with torch.autocast(
            device_type="cuda",
            dtype=torch.float16,
            enabled=USE_FP16
        ):

            encoded = vae.encode(
                image_tensor
            )

            latent = encoded.latent_dist.sample()

            latent = (
                latent * vae.config.scaling_factor
            )

        latent_cache[image_name] = (
            latent[0]
            .detach()
            .cpu()
            .to(torch.float16)
        )

        del image_tensor
        del encoded
        del latent


print("Cached image latents:", len(latent_cache))


# ============================================================
# 13. RELEASE VAE GPU MEMORY
# ============================================================

del vae

clear_memory()

print_gpu_memory(
    "After releasing VAE"
)


# ============================================================
# 14. CACHED TRAINING DATASET
# ============================================================

class CachedPixArtDataset(Dataset):

    def __init__(
        self,
        dataframe,
        latent_cache,
        text_cache
    ):

        self.df = dataframe.reset_index(drop=True)

        self.latent_cache = latent_cache
        self.text_cache = text_cache

    def __len__(self):

        return len(self.df)

    def __getitem__(self, index):

        row = self.df.iloc[index]

        image_name = row["image_name"]
        caption = row["comment"]

        latent = self.latent_cache[
            image_name
        ]

        text_embedding, attention_mask = (
            self.text_cache[caption]
        )

        return (
            latent,
            text_embedding,
            attention_mask
        )


train_dataset = CachedPixArtDataset(
    train_df,
    latent_cache,
    text_embedding_cache
)

validation_dataset = CachedPixArtDataset(
    validation_df,
    latent_cache,
    text_embedding_cache
)


train_loader = DataLoader(
    train_dataset,
    batch_size=BATCH_SIZE,
    shuffle=True,
    num_workers=NUM_WORKERS,
    pin_memory=False
)

validation_loader = DataLoader(
    validation_dataset,
    batch_size=BATCH_SIZE,
    shuffle=False,
    num_workers=NUM_WORKERS,
    pin_memory=False
)


# ============================================================
# 15. STAGE 3: LOAD PIXART TRANSFORMER ON GPU
# ============================================================

print("\nLoading PixArt transformer...")

clear_memory()

print_gpu_memory(
    "Before loading PixArt"
)

transformer = PixArtTransformer2DModel.from_pretrained(
    MODEL_NAME,
    subfolder="transformer",
    torch_dtype=(
        torch.float16 if USE_FP16 else torch.float32
    )
)

transformer.to(DEVICE)

transformer.train()

print("PixArt loaded on:", DEVICE)

print_gpu_memory(
    "After loading PixArt"
)


# ============================================================
# 16. FREEZE ALL PIXART PARAMETERS
# ============================================================

transformer.requires_grad_(False)


# ============================================================
# 17. UNFREEZE LAST TWO TRANSFORMER BLOCKS
# ============================================================

if not hasattr(transformer, "transformer_blocks"):

    raise RuntimeError(
        "Expected transformer_blocks in PixArt model. "
        "Check your Diffusers model version."
    )

blocks = transformer.transformer_blocks

if len(blocks) < NUM_TRAINABLE_BLOCKS:

    raise RuntimeError(
        "Requested more trainable blocks than available."
    )

trainable_blocks = blocks[
    -NUM_TRAINABLE_BLOCKS:
]

for block in trainable_blocks:

    block.requires_grad_(True)


# Unfreeze output projection.

transformer.proj_out.requires_grad_(True)


# ============================================================
# 18. ENABLE GRADIENT CHECKPOINTING
# ============================================================

transformer.enable_gradient_checkpointing()

print("\nGradient checkpointing enabled")


# ============================================================
# 19. KEEP TRAINABLE PARAMETERS IN FP32
# ============================================================

trainable_parameters = []

for parameter in transformer.parameters():

    if parameter.requires_grad:

        parameter.data = (
            parameter.data.float()
        )

        trainable_parameters.append(
            parameter
        )


total_parameters = sum(
    parameter.numel()
    for parameter in transformer.parameters()
)

trainable_count = sum(
    parameter.numel()
    for parameter in trainable_parameters
)

print("\nPixArt parameter information")

print(
    "Total parameters:",
    f"{total_parameters:,}"
)

print(
    "Trainable parameters:",
    f"{trainable_count:,}"
)

print(
    "Trainable percentage:",
    f"{100 * trainable_count / total_parameters:.2f}%"
)

if trainable_count == 0:
    raise RuntimeError("No trainable parameters found.")


# ============================================================
# 20. LOAD DIFFUSION NOISE SCHEDULER
# ============================================================

noise_scheduler = DDPMScheduler.from_pretrained(
    MODEL_NAME,
    subfolder="scheduler"
)

print(
    "\nPrediction type:",
    noise_scheduler.config.prediction_type
)


# ============================================================
# 21. OPTIMIZER
# ============================================================

optimizer = torch.optim.AdamW(
    trainable_parameters,
    lr=LEARNING_RATE,
    weight_decay=WEIGHT_DECAY,
    betas=(0.9, 0.999),
    eps=1e-8,
    foreach=False
)


# ============================================================
# 22. PIXART TRAINING LOSS
# ============================================================

def calculate_loss(
    batch,
    training=True
):

    latents, text_embeddings, attention_mask = batch

    latents = latents.to(
        DEVICE,
        dtype=torch.float16 if USE_FP16 else torch.float32
    )

    text_embeddings = text_embeddings.to(
        DEVICE,
        dtype=torch.float16 if USE_FP16 else torch.float32
    )

    attention_mask = attention_mask.to(
        DEVICE
    )

    batch_size = latents.shape[0]

    # Caption dropout for classifier-free guidance.
    # With BATCH_SIZE=1, this drops the current caption.

    if training and random.random() < CAPTION_DROPOUT:

        unconditional_embedding, unconditional_mask = (
            text_embedding_cache[""]
        )

        text_embeddings = (
            unconditional_embedding
            .unsqueeze(0)
            .expand(batch_size, -1, -1)
            .to(
                DEVICE,
                dtype=(
                    torch.float16 if USE_FP16 else torch.float32
                )
            )
        )

        attention_mask = (
            unconditional_mask
            .unsqueeze(0)
            .expand(batch_size, -1)
            .to(DEVICE)
        )

    # Generate random diffusion noise.

    noise = torch.randn_like(latents)

    # Random diffusion timesteps.

    timesteps = torch.randint(
        0,
        noise_scheduler.config.num_train_timesteps,
        (batch_size,),
        device=DEVICE
    ).long()

    # Add noise to latent images.

    noisy_latents = noise_scheduler.add_noise(
        latents,
        noise,
        timesteps
    )

    # PixArt additional conditioning.

    resolution = torch.tensor(
        [[IMAGE_SIZE, IMAGE_SIZE]],
        device=DEVICE
    ).repeat(batch_size, 1)

    aspect_ratio = torch.ones(
        (batch_size, 1),
        device=DEVICE
    )

    added_cond_kwargs = {
        "resolution": resolution,
        "aspect_ratio": aspect_ratio
    }

    with torch.autocast(
        device_type="cuda",
        dtype=torch.float16,
        enabled=USE_FP16
    ):

        prediction = transformer(
            hidden_states=noisy_latents,
            encoder_hidden_states=text_embeddings,
            encoder_attention_mask=attention_mask,
            timestep=timesteps,
            added_cond_kwargs=added_cond_kwargs,
            return_dict=True
        ).sample

    # PixArt may return 2 * latent_channels:
    # the first half is the noise/velocity prediction, and the
    # second half is the learned-variance prediction.
    # The current training objective uses only the first half.
    expected_channels = latents.shape[1]

    if prediction.shape[1] == 2 * expected_channels:
        prediction, predicted_variance = torch.chunk(
            prediction,
            2,
            dim=1
        )
    elif prediction.shape[1] != expected_channels:
        raise RuntimeError(
            f"Unexpected PixArt output shape: {tuple(prediction.shape)}. "
            f"Expected {expected_channels} or "
            f"{2 * expected_channels} channels."
        )

    prediction_type = (
        noise_scheduler.config.prediction_type
    )

    if prediction_type == "epsilon":

        target = noise

    elif prediction_type == "v_prediction":

        target = noise_scheduler.get_velocity(
            latents,
            noise,
            timesteps
        )

    else:

        raise ValueError(
            f"Unsupported prediction type: {prediction_type}"
        )

    if prediction.shape != target.shape:
        raise RuntimeError(
            "Prediction/target shape mismatch before MSE: "
            f"prediction={tuple(prediction.shape)}, "
            f"target={tuple(target.shape)}"
        )

    loss = F.mse_loss(
        prediction.float(),
        target.float(),
        reduction="mean"
    )

    return loss


# ============================================================
# 23. TRAINING LOOP
# ============================================================

training_history = []

print_gpu_memory(
    "GPU memory before training"
)

print("\nStarting PixArt fine-tuning...")


for epoch in range(EPOCHS):

    transformer.train()

    train_loss_total = 0.0

    optimizer.zero_grad(
        set_to_none=True
    )

    progress = tqdm(
        enumerate(train_loader),
        total=len(train_loader),
        desc=f"Epoch {epoch + 1}/{EPOCHS}"
    )

    for step, batch in progress:

        loss = calculate_loss(
            batch,
            training=True
        )

        scaled_loss = (
            loss / GRADIENT_ACCUMULATION_STEPS
        )

        scaled_loss.backward()

        train_loss_total += loss.item()

        should_update = (
            (step + 1) % GRADIENT_ACCUMULATION_STEPS == 0
            or (step + 1) == len(train_loader)
        )

        if should_update:

            torch.nn.utils.clip_grad_norm_(
                trainable_parameters,
                max_norm=1.0
            )

            optimizer.step()

            optimizer.zero_grad(
                set_to_none=True
            )

        progress.set_postfix(
            loss=f"{loss.item():.4f}"
        )

    train_loss = (
        train_loss_total / max(len(train_loader), 1)
    )


    # ========================================================
    # VALIDATION
    # ========================================================

    transformer.eval()

    validation_loss_total = 0.0

    with torch.no_grad():

        for batch in tqdm(
            validation_loader,
            desc="Validation"
        ):

            loss = calculate_loss(
                batch,
                training=False
            )

            validation_loss_total += loss.item()

    validation_loss = (
        validation_loss_total /
        max(len(validation_loader), 1)
    )


    # ========================================================
    # SAVE TRAINABLE PARAMETERS
    # ========================================================

    epoch_checkpoint = {}

    for name, parameter in transformer.named_parameters():

        if parameter.requires_grad:

            epoch_checkpoint[name] = (
                parameter.detach()
                .cpu()
                .clone()
            )

    checkpoint_path = os.path.join(
        OUTPUT_DIR,
        f"trainable_epoch_{epoch + 1}.pt"
    )

    torch.save(
        epoch_checkpoint,
        checkpoint_path
    )


    # ========================================================
    # RECORD HISTORY
    # ========================================================

    epoch_result = {
        "epoch": epoch + 1,
        "train_loss": float(train_loss),
        "validation_loss": float(validation_loss)
    }

    training_history.append(
        epoch_result
    )

    with open(
        os.path.join(
            OUTPUT_DIR,
            "training_history.json"
        ),
        "w"
    ) as file:

        json.dump(
            training_history,
            file,
            indent=4
        )


    print(
        f"\nEpoch {epoch + 1}/{EPOCHS}"
    )

    print(
        f"Training Loss: {train_loss:.6f}"
    )

    print(
        f"Validation Loss: {validation_loss:.6f}"
    )

    print(
        "Saved:",
        checkpoint_path
    )

    clear_memory()

    print_gpu_memory(
        f"After epoch {epoch + 1}"
    )


# ============================================================
# 24. SAVE COMPLETE FINE-TUNED TRANSFORMER
# ============================================================

print("\nSaving complete PixArt transformer...")

transformer.save_pretrained(
    TRANSFORMER_OUTPUT_DIR,
    safe_serialization=True
)


# ============================================================
# 25. SAVE TRAINING CONFIGURATION
# ============================================================

training_config = {

    "model_name": MODEL_NAME,

    "image_size": IMAGE_SIZE,

    "max_text_length": MAX_TEXT_LENGTH,

    "max_images": MAX_IMAGES,

    "training_images": TRAIN_IMAGES,

    "validation_images": VALIDATION_IMAGES,

    "batch_size": BATCH_SIZE,

    "epochs": EPOCHS,

    "learning_rate": LEARNING_RATE,

    "weight_decay": WEIGHT_DECAY,

    "gradient_accumulation_steps":
        GRADIENT_ACCUMULATION_STEPS,

    "caption_dropout": CAPTION_DROPOUT,

    "trainable_blocks": NUM_TRAINABLE_BLOCKS,

    "mixed_precision": "fp16" if USE_FP16 else "fp32",

    "trainable_parameters": int(trainable_count),

    "total_parameters": int(total_parameters)

}

with open(
    os.path.join(
        OUTPUT_DIR,
        "training_config.json"
    ),
    "w"
) as file:

    json.dump(
        training_config,
        file,
        indent=4
    )


# ============================================================
# 26. FINISHED
# ============================================================

print("\n" + "=" * 60)

print("PIXART FINE-TUNING COMPLETED")

print("=" * 60)

print("Output directory:", OUTPUT_DIR)

