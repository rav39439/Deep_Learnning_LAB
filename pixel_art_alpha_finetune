#-------------------------inference------------------------------


# =========================================================
# MEMORY-OPTIMIZED PIXART-ALPHA INFERENCE
# CPU MODEL OFFLOADING
# =========================================================

import os
import gc
import torch

from IPython.display import display

from diffusers import (
    PixArtAlphaPipeline,
    PixArtTransformer2DModel,
    DPMSolverMultistepScheduler
)

# =========================================================
# 1. CONFIGURATION
# =========================================================

MODEL_NAME = "PixArt-alpha/PixArt-XL-2-512x512"

OUTPUT_DIR = "/kaggle/working/pixart_finetuned"

TRANSFORMER_DIR = os.path.join(
    OUTPUT_DIR,
    "transformer"
)

EPOCH_TO_LOAD = 5

OUTPUT_IMAGE = os.path.join(
    OUTPUT_DIR,
    "demo_prediction.png"
)

DEVICE = "cuda" if torch.cuda.is_available() else "cpu"

DTYPE = (
    torch.float16
    if DEVICE == "cuda"
    else torch.float32
)

# =========================================================
# 2. RELEASE UNUSED MEMORY
# =========================================================

gc.collect()

if torch.cuda.is_available():
    torch.cuda.empty_cache()
    torch.cuda.ipc_collect()

if not os.path.isdir(TRANSFORMER_DIR):
    raise FileNotFoundError(TRANSFORMER_DIR)

# =========================================================
# 3. LOAD SAVED TRANSFORMER ON CPU
# =========================================================

print("Loading saved Transformer...")

transformer = PixArtTransformer2DModel.from_pretrained(
    TRANSFORMER_DIR,
    torch_dtype=DTYPE,
    low_cpu_mem_usage=True
)

transformer.eval()

print("Transformer loaded.")

# =========================================================
# 4. LOAD EPOCH CHECKPOINT
# =========================================================

checkpoint_candidates = [
    os.path.join(
        OUTPUT_DIR,
        f"trainable_epoch_{EPOCH_TO_LOAD}.pt"
    ),
    os.path.join(
        OUTPUT_DIR,
        f"trainable_epoch{EPOCH_TO_LOAD}.pt"
    )
]

checkpoint_path = next(
    (
        p for p in checkpoint_candidates
        if os.path.isfile(p)
    ),
    None
)

if checkpoint_path:

    print("Loading checkpoint:", checkpoint_path)

    try:
        checkpoint = torch.load(
            checkpoint_path,
            map_location="cpu",
            weights_only=True
        )
    except TypeError:
        checkpoint = torch.load(
            checkpoint_path,
            map_location="cpu"
        )

    if "state_dict" in checkpoint:
        checkpoint = checkpoint["state_dict"]

    current_state = transformer.state_dict()

    compatible = {
        name: value
        for name, value in checkpoint.items()
        if (
            name in current_state
            and current_state[name].shape == value.shape
        )
    }

    if not compatible:
        raise RuntimeError(
            "No compatible epoch weights found."
        )

    current_state.update(compatible)

    transformer.load_state_dict(current_state)

    print(
        "Loaded trainable tensors:",
        len(compatible)
    )

    del checkpoint
    del current_state
    del compatible

else:
    print(
        "Epoch checkpoint not found. "
        "Using the complete saved Transformer."
    )

gc.collect()

# =========================================================
# 5. LOAD PIPELINE ON CPU
# =========================================================

print("\nLoading PixArt pipeline...")

pipe = PixArtAlphaPipeline.from_pretrained(
    MODEL_NAME,
    transformer=transformer,
    torch_dtype=DTYPE,
    low_cpu_mem_usage=True
)

del transformer
gc.collect()

# =========================================================
# 6. INFERENCE SCHEDULER
# =========================================================

pipe.scheduler = DPMSolverMultistepScheduler.from_config(
    pipe.scheduler.config
)

# =========================================================
# 7. ENABLE CPU OFFLOADING
# =========================================================

if DEVICE == "cuda":

    # Moves components to GPU only when needed.
    # Do NOT call pipe.to("cuda") after this.

    pipe.enable_model_cpu_offload()

    print("CPU model offloading enabled.")

else:

    pipe.to("cpu")

# =========================================================
# 8. TEXT PROMPT
# =========================================================

prompt = (
    "A majestic snow leopard sitting on a rocky mountain cliff "
    "overlooking a vast Himalayan mountain range, snow-covered peaks, "
    "soft morning sunlight, ultra-realistic wildlife photography, "
    "highly detailed fur, sharp focus, natural colors, "
    "cinematic composition, 8K photography"
)

negative_prompt = (
    "blurry, low quality, distorted, deformed, "
    "bad anatomy, unrealistic proportions"
)

# =========================================================
# 9. GENERATE IMAGE
# =========================================================

generator = torch.Generator(
    device="cpu"
).manual_seed(42)

print("\nGenerating image...")

with torch.inference_mode():

    result = pipe(
        prompt=prompt,
        negative_prompt=negative_prompt,

        height=512,
        width=512,

        num_inference_steps=20,

        guidance_scale=4.5,

        num_images_per_prompt=1,

        generator=generator
    )

generated_image = result.images[0]

# =========================================================
# 10. SAVE AND DISPLAY
# =========================================================

generated_image.save(OUTPUT_IMAGE)

display(generated_image)

print("\nImage generated successfully.")
print("Saved:", OUTPUT_IMAGE)
if torch.cuda.is_available():

    print(
        "GPU allocated:",
        round(
            torch.cuda.memory_allocated() / 1024**3,
            2
        ),
        "GB"
    )
