def extract_text(value):

    if isinstance(value, str):

        return value.strip()

    if isinstance(value, dict):

        return extract_text(
            value.get("text", "")
        )

    if isinstance(value, list):

        extracted = []

        for item in value:

            text = extract_text(item)

            if text:

                extracted.append(text)

        return " ".join(extracted)

    if isinstance(value, np.ndarray):

        return extract_text(
            value.tolist()
        )

    return ""


