ANSWER_PREFIX_IDS = tokenizer.encode(
    "\nAnswer: ",
    add_special_tokens=False
)


END_IDS = tokenizer.encode(
    "\nEnd of answer.",
    add_special_tokens=False
)


def encode_qa(
    question,
    answer,
    seq_len
):

    # -----------------------------------------------------
    # Tokenize question/context
    # -----------------------------------------------------

    question_ids = tokenizer.encode(
        question,
        add_special_tokens=False
    )

    # -----------------------------------------------------
    # Tokenize answer
    # -----------------------------------------------------

    answer_ids = tokenizer.encode(
        answer,
        add_special_tokens=False
    )

    # -----------------------------------------------------
    # Reserve space for prefixes, ending phrase,
    # and at least one answer token.
    # -----------------------------------------------------

    fixed_overhead = (
        len(QUESTION_PREFIX_IDS)
        + len(ANSWER_PREFIX_IDS)
        + len(END_IDS)
    )

    max_question_tokens = max(
        0,
        seq_len - fixed_overhead - 1
    )

    # Truncate question/context if necessary.

    question_ids = question_ids[
        :max_question_tokens
    ]

    # -----------------------------------------------------
    # Build question prefix
    # -----------------------------------------------------

    prefix_ids = (
        QUESTION_PREFIX_IDS
        + question_ids
        + ANSWER_PREFIX_IDS
    )

    # -----------------------------------------------------
    # Reserve remaining space for answer.
    # -----------------------------------------------------

    answer_capacity = (
        seq_len
        - len(prefix_ids)
        - len(END_IDS)
    )

    answer_ids = answer_ids[
        :answer_capacity
    ]

    if not answer_ids:

        return None

    # -----------------------------------------------------
    # Complete sequence
    # -----------------------------------------------------

    token_ids = (
        prefix_ids
        + answer_ids
        + END_IDS
    )

    # -----------------------------------------------------
    # Next-token prediction
    # -----------------------------------------------------

    input_ids = token_ids[:-1]

    target_ids = token_ids[1:]

    # -----------------------------------------------------
    # Identify first answer target position
    # -----------------------------------------------------

    first_answer_target = (
        len(prefix_ids) - 1
    )

    # -----------------------------------------------------
    # Answer-only loss weights
    # -----------------------------------------------------

    token_weights = np.zeros(
        len(target_ids),
        dtype=np.float32
    )

    # Only answer tokens and ending phrase
    # contribute to training loss.

    token_weights[
        first_answer_target:
    ] = 1.0

    # -----------------------------------------------------
    # Padding
    # -----------------------------------------------------

    padding_length = (
        (seq_len - 1) - len(input_ids)
    )

    input_ids += (
        [PAD_ID] * padding_length
    )

    target_ids += (
        [PAD_ID] * padding_length
    )

    token_weights = np.pad(
        token_weights,
        (0, padding_length)
    )

    return (
        input_ids,
        target_ids,
        token_weights
    )


