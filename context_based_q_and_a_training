# 14. GENERATE ANSWERS
# =========================================================

def generate_answer(

    model,

    tokenizer,

    question,

    seq_len=SEQ_LEN,

    max_gen=150

):

    # The question may contain:
    # Context + Question

    prompt = (
        f"Question: {question}\n"
        f"Answer:"
    )


    token_ids = tokenizer.encode(

        prompt,

        add_special_tokens=False
    )


    if not token_ids:

        raise ValueError(
            "Question produced no tokens."
        )


    # Retain the most recent context.

    token_ids = token_ids[
        -(seq_len - 1):
    ]


    input_seq = tf.constant(

        [token_ids],

        dtype=tf.int32
    )

    generated_ids = []


    for _ in range(max_gen):

        logits = model(

            input_seq,

            training=False
        )


        next_id = tf.argmax(

            logits[:, -1, :],

            axis=-1,

            output_type=tf.int32
        )


        next_id_value = int(
            next_id.numpy()[0]
        )


        generated_ids.append(
            next_id_value
        )


        # Detect ordinary-text ending phrase.

        if (

            len(generated_ids) >= len(END_IDS)

            and generated_ids[
                -len(END_IDS):
            ] == END_IDS

        ):

            generated_ids = generated_ids[
                :-len(END_IDS)
            ]

            break


        input_seq = tf.concat(

            [

                input_seq,

                tf.reshape(
                    next_id,
                    (1, 1)
                )

            ],

            axis=1
        )


        if input_seq.shape[1] > seq_len - 1:

            input_seq = input_seq[
                :, -(seq_len - 1):
            ]


    return tokenizer.decode(

        generated_ids,

        skip_special_tokens=True

    ).strip()


