def configure_trainable_layers(model):

    # Keep the model trainable at the top level.
    model.trainable = True

    # Freeze embedding.
    model.embedding.trainable = False

    # Freeze all decoder layers except the last 8.
    NUM_TRAINABLE_LAYERS = 8
    NUM_FROZEN_LAYERS = NUM_LAYERS - NUM_TRAINABLE_LAYERS

    for i in range(NUM_FROZEN_LAYERS):
        model.dec_layers[i].trainable = False

    # Unfreeze the last 8 decoder layers.
    for i in range(NUM_FROZEN_LAYERS, NUM_LAYERS):
        model.dec_layers[i].trainable = True

    # Freeze final language-model head.
    model.final_layer.trainable = False

    print("\nLayer trainability:")

    for i, layer in enumerate(model.dec_layers):

        status = (
            "TRAINABLE"
            if layer.trainable
            else "FROZEN"
        )

        print(f"Layer {i + 1:02d}: {status}")

    print("\nEmbedding: FROZEN")
    print("LM head: FROZEN")
    print(f"Trainable decoder layers: {NUM_TRAINABLE_LAYERS}")
    print(f"Frozen decoder layers: {NUM_FROZEN_LAYERS}")
