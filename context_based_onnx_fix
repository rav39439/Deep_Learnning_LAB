# ============================================================
# 9. INTERACTIVE CONTEXT + QUESTION INFERENCE
# ============================================================

print("\n" + "=" * 65)
print("INTERACTIVE ONNX TRANSFORMER")
print("=" * 65)

print("Enter your context and question.")
print("Type 'exit' to stop.")

while True:

    print("\n" + "-" * 65)

    context_input = input(
        "\nEnter context (or exit):\n"
    ).strip()

    if context_input.lower() in ["exit", "quit"]:
        print("Inference stopped.")
        break

    if not context_input:
        print("Context cannot be empty.")
        continue

    question_input = input(
        "\nEnter your question:\n"
    ).strip()

    if question_input.lower() in ["exit", "quit"]:
        print("Inference stopped.")
        break

    if not question_input:
        print("Question cannot be empty.")
        continue

    answer = generate_answer_onnx(
        context=context_input,
        question=question_input,
        max_gen=MAX_GEN
    )

    print("\nGENERATED ANSWER:")
    print(answer)

    print("-" * 65)


