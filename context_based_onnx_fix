# ============================================================
# ONNX DECODER-ONLY TRANSFORMER
# CONTEXT + QUESTION ANSWERING INFERENCE
# ============================================================

import os
import numpy as np
import onnxruntime as ort
from transformers import BertTokenizerFast


# ============================================================
# 1. CONFIGURATION
# ============================================================

ONNX_MODEL_PATH = (
    "/kaggle/working/transformer_fixed.onnx"
)

TOKENIZER_PATH = (
    "/kaggle/input/datasets/ravckumar/"
    "instruction_tuning3/tokenizer"
)

SEQ_LEN = 512
MAX_GEN = 150

# Replace with the exact END_IDS used during training.
# This example assumes [SEP] is your stopping token.


# ============================================================
# 2. LOAD TOKENIZER
# ============================================================

if os.path.isdir(TOKENIZER_PATH):

    tokenizer = BertTokenizerFast.from_pretrained(
        TOKENIZER_PATH
    )
    print("Saved tokenizer loaded.")

else:

    tokenizer = BertTokenizerFast.from_pretrained("bert-base-uncased")

    special_tokens = {
        "additional_special_tokens": [
            "<question>",
            "</question>",
            "<answer>",
            "</answer>",
            "<END>"
        ]
    }
    
    tokenizer.add_special_tokens(special_tokens)

VOCAB_SIZE = tokenizer.vocab_size + len(special_tokens["additional_special_tokens"])


print("\nTokenizer information:")
print("Vocabulary size:", tokenizer.vocab_size)
print("Total tokenizer length:", len(tokenizer))
print("PAD token ID:", tokenizer.pad_token_id)
print("SEP token ID:", tokenizer.sep_token_id)

# ============================================================
# 3. LOAD ONNX MODEL
# ============================================================

if not os.path.isfile(ONNX_MODEL_PATH):
    raise FileNotFoundError(
        f"ONNX model not found: {ONNX_MODEL_PATH}"
    )


session = ort.InferenceSession(
    ONNX_MODEL_PATH,
    providers=["CPUExecutionProvider"]
)

input_name = session.get_inputs()[0].name
output_name = session.get_outputs()[0].name

print("\nONNX model loaded successfully.")

print("Input name:", input_name)
print("Input shape:", session.get_inputs()[0].shape)

print("Output name:", output_name)
print("Output shape:", session.get_outputs()[0].shape)


# ============================================================
# 4. VALIDATE MODEL INPUT AND OUTPUT
# ============================================================

if len(session.get_inputs()) != 1:
    raise ValueError(
        "Expected exactly one ONNX input."
    )

if session.get_inputs()[0].type != "tensor(int32)":
    raise TypeError(
        "Expected ONNX input type tensor(int32)."
    )

model_vocab_size = session.get_outputs()[0].shape[-1]

if isinstance(model_vocab_size, int):

    print("\nModel output vocabulary:", model_vocab_size)

    if len(tokenizer) != model_vocab_size:

        print(
            "\nWARNING: Tokenizer/model vocabulary mismatch!"
        )

        print(
            "Tokenizer length:",
            len(tokenizer)
        )

        print(
            "Model vocabulary:",
            model_vocab_size
        )


# ============================================================
# 5. END TOKEN CONFIGURATION
# ============================================================

# IMPORTANT:
# Use the exact END_IDS from your training code.
# Here SEP is used as an example.

END_IDS = [tokenizer.sep_token_id]

if any(token_id is None for token_id in END_IDS):
    raise ValueError("Invalid END_IDS configuration.")

print("\nEnd token IDs:", END_IDS)


# ============================================================
# 6. ONNX MODEL GENERATION FUNCTION
# ============================================================

def generate_answer_onnx(
    context,
    question,
    max_gen=MAX_GEN
):

    # --------------------------------------------------------
    # Construct prompt
    # --------------------------------------------------------

    prompt = (
        f"Context: {context}\n"
        f"Question: {question}\n"
        f"Answer:"
    )

    # --------------------------------------------------------
    # Tokenization
    # --------------------------------------------------------

    token_ids = tokenizer.encode(
        prompt,
        add_special_tokens=False
    )

    if not token_ids:
        raise ValueError(
            "The input context and question produced no tokens."
        )

    # Preserve the end of the prompt if it exceeds the window.
    token_ids = token_ids[-(SEQ_LEN - 1):]

    generated_ids = []

    # --------------------------------------------------------
    # Autoregressive generation
    # --------------------------------------------------------

    for step in range(max_gen):

        # Combine prompt and previously generated tokens.
        context_ids = (
            token_ids + generated_ids
        )[-SEQ_LEN:]

        actual_length = len(context_ids)

        # Fixed-length right padding.
        padded_ids = (
            context_ids
            + [tokenizer.pad_token_id] *
            (SEQ_LEN - actual_length)
        )

        input_array = np.asarray(
            [padded_ids],
            dtype=np.int32
        )

        # ----------------------------------------------------
        # ONNX inference
        # ----------------------------------------------------

        logits = session.run(
            [output_name],
            {
                input_name: input_array
            }
        )[0]

        # Select logits at the last actual token position.
        next_token_logits = logits[
            0,
            actual_length - 1,
            :
        ]

        # Greedy decoding.
        next_id = int(
            np.argmax(next_token_logits)
        )

        # ----------------------------------------------------
        # Validate token ID
        # ----------------------------------------------------

        if next_id >= len(tokenizer):

            raise ValueError(
                f"Generated token ID {next_id} is outside "
                f"the tokenizer vocabulary ({len(tokenizer)}). "
                "Check the tokenizer used during training."
            )

        generated_ids.append(next_id)

        # ----------------------------------------------------
        # Stop-token checking
        # ----------------------------------------------------

        if (
            len(generated_ids) >= len(END_IDS)
            and generated_ids[-len(END_IDS):] == END_IDS
        ):

            generated_ids = generated_ids[:-len(END_IDS)]

            break

    # --------------------------------------------------------
    # Decode answer
    # --------------------------------------------------------

    answer = tokenizer.decode(
        generated_ids,
        skip_special_tokens=True
    ).strip()

    return answer


# ============================================================
# 7. EXAMPLE 1: CONTEXT-BASED QUESTION ANSWERING
# ============================================================

context = """
Artificial intelligence is a branch of computer science
that focuses on building machines capable of performing
tasks that typically require human intelligence.

Machine learning is a subset of artificial intelligence.
It allows computers to learn patterns from data and make
predictions without being explicitly programmed for every task.

Deep learning is a subset of machine learning that uses
neural networks with multiple layers to learn complex patterns.
"""

question = """
What is the relationship between artificial intelligence,
machine learning, and deep learning?
"""

answer = generate_answer_onnx(
    context=context,
    question=question
)

print("\n" + "=" * 65)
print("EXAMPLE 1: CONTEXT-BASED QUESTION ANSWERING")
print("=" * 65)

print("\nCONTEXT:\n")
print(context)

print("\nQUESTION:\n")
print(question)

print("\nGENERATED ANSWER:\n")
print(answer)


