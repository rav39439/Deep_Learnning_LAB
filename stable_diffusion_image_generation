# ============================================================
# STABLE DIFFUSION 1.5 INFERENCE
# CPU LOADING + GPU OFFLOADING
# MEMORY OPTIMIZED FOR 14.56 GB GPU
# ============================================================

import os
import gc
import torch

from IPython.display import display

from diffusers import (
    StableDiffusionPipeline,
    UNet2DConditionModel,
    DPMSolverMultistepScheduler
)


# ============================================================
# 1. CONFIGURATION
# ============================================================

MODEL_NAME = (
    "stable-diffusion-v1-5/"
    "stable-diffusion-v1-5"
)

OUTPUT_DIR = (
    "/kaggle/working/"
    "stable_diffusion15_finetuned"
)

UNET_OUTPUT_DIR = os.path.join(
    OUTPUT_DIR,
    "unet"
)

EPOCH_TO_LOAD = None

OUTPUT_IMAGE = os.path.join(
    OUTPUT_DIR,
    "demo_prediction.png"
)

DEVICE = (
    "cuda"
    if torch.cuda.is_available()
    else "cpu"
)

DTYPE = (
    torch.float16
    if DEVICE == "cuda"
    else torch.float32
)


# ============================================================
# 2. RELEASE UNUSED GPU MEMORY
# ============================================================

gc.collect()

if torch.cuda.is_available():

    torch.cuda.empty_cache()

    torch.cuda.ipc_collect()

    print(
        "GPU free before loading:",
        round(
            torch.cuda.mem_get_info()[0] / 1024**3,
            2
        ),
        "GB"
    )


if not os.path.isdir(UNET_OUTPUT_DIR):

    raise FileNotFoundError(
        UNET_OUTPUT_DIR
    )


# ============================================================
# 3. LOAD FINE-TUNED UNET ON CPU
# ============================================================

print(
    "\nLoading fine-tuned UNet on CPU..."
)

unet = UNet2DConditionModel.from_pretrained(

    UNET_OUTPUT_DIR,

    torch_dtype=DTYPE,

    low_cpu_mem_usage=True,

    use_safetensors=True,

    device_map="cpu"

)

unet.eval()

print(
    "UNet loaded on CPU."
)


# ============================================================
# 4. OPTIONAL EPOCH CHECKPOINT
# ============================================================

if EPOCH_TO_LOAD is not None:

    checkpoint_path = os.path.join(
        OUTPUT_DIR,
        f"trainable_epoch_{EPOCH_TO_LOAD}.pt"
    )

    if not os.path.isfile(checkpoint_path):

        raise FileNotFoundError(
            checkpoint_path
        )

    print(
        "Loading epoch checkpoint:",
        checkpoint_path
    )

    checkpoint = torch.load(
        checkpoint_path,
        map_location="cpu",
        weights_only=True
    )

    if "state_dict" in checkpoint:

        checkpoint = checkpoint["state_dict"]

    current_state = unet.state_dict()

    compatible = {

        name: value

        for name, value in checkpoint.items()

        if (
            name in current_state
            and current_state[name].shape == value.shape
        )

    }

    if not compatible:

        raise RuntimeError(
            "No compatible epoch weights found."
        )

    unet.load_state_dict(
        compatible,
        strict=False
    )

    print(
        "Loaded trainable tensors:",
        len(compatible)
    )

    del checkpoint
    del current_state
    del compatible

    gc.collect()


# ============================================================
# 5. LOAD COMPLETE PIPELINE ON CPU
# ============================================================

print(
    "\nLoading Stable Diffusion pipeline on CPU..."
)

pipe = StableDiffusionPipeline.from_pretrained(

    MODEL_NAME,

    unet=unet,

    torch_dtype=DTYPE,

    low_cpu_mem_usage=True,

    device_map="cpu",

    safety_checker=None

)

del unet

gc.collect()

print(
    "Complete Stable Diffusion pipeline loaded on CPU."
)


# ============================================================
# 6. INFERENCE SCHEDULER
# ============================================================

pipe.scheduler = (
    DPMSolverMultistepScheduler.from_config(
        pipe.scheduler.config
    )
)


# ============================================================
# 7. ENABLE CPU OFFLOADING
# ============================================================

if DEVICE == "cuda":

    # Move individual components to GPU when required.
    # The pipeline remains CPU-loaded initially.

    pipe.enable_model_cpu_offload(
        gpu_id=0
    )

    print(
        "Model CPU offloading enabled."
    )

else:

    pipe.to("cpu")

    print(
        "CPU inference enabled."
    )


# ============================================================
# 8. PROMPT
# ============================================================

prompt = (

    "A majestic snow leopard sitting on a rocky "
    "mountain cliff overlooking a vast Himalayan "
    "mountain range, snow-covered peaks, soft "
    "morning sunlight, ultra-realistic wildlife "
    "photography, highly detailed fur, sharp focus, "
    "natural colors, cinematic composition"

)

negative_prompt = (

    "blurry, low quality, distorted, deformed, "
    "bad anatomy, unrealistic proportions, "
    "poor details, low resolution"

)


# ============================================================
# 9. IMAGE GENERATION
# ============================================================

generator = torch.Generator(
    device="cpu"
).manual_seed(42)

print(
    "\nGenerating image..."
)

with torch.inference_mode():

    result = pipe(

        prompt=prompt,

        negative_prompt=negative_prompt,

        height=512,

        width=512,

        num_inference_steps=25,

        guidance_scale=7.5,

        num_images_per_prompt=1,

        generator=generator

    )

generated_image = result.images[0]


# ============================================================
# 10. SAVE AND DISPLAY
# ============================================================

generated_image.save(
    OUTPUT_IMAGE
)

display(
    generated_image
)

print(
    "\nImage generated successfully."
)

print(
    "Saved:",
    OUTPUT_IMAGE
)

if torch.cuda.is_available():

    print(
        "GPU allocated:",
        round(
            torch.cuda.memory_allocated() / 1024**3,
            2
        ),
        "GB"
    )
